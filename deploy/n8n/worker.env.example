# Copy to worker.env, then protect the file (chmod 600 on Linux).
# Python supplies tools/state/PDF/Wiki.js only. Configure model credentials in n8n.
PGHOST=postgres.example.internal
PGPORT=5432
PGDATABASE=products
PGUSER=products_readonly
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=/run/pv-wiki/catalogue-ca.pem

# compose.datasheet.yaml mounts the Exa rotation set and evidence signing key.
# Set EXA_KEYS_PATH and EVIDENCE_KEY_PATH in deploy/n8n/.env.
EXA_API_KEYS_FILE=/run/secrets/pv-wiki-exa-keys
PV_WIKI_EVIDENCE_HMAC_KEY_FILE=/run/secrets/pv-wiki-evidence-hmac-key
PV_WIKI_DATASHEET_CACHE_DIR=/var/lib/pv-wiki/datasheets
PV_WIKI_SESSION_TTL_SECONDS=3600

WIKIJS_URL=https://wiki.example.com
WIKIJS_TOKEN=
WIKIJS_LOCALE=zh-cn
WIKIJS_PATH_PREFIX=products
WIKIJS_HOME_PATH=home
WIKIJS_HOME_TITLE=GTI 产品百科
WIKIJS_NEW_PAGE_PRIVATE=true
WIKIJS_NEW_PAGE_PUBLISHED=false

# Same value as the n8n worker credential. Never put this in workflow JSON.
PV_WIKI_WORKER_TOKEN=
PV_WIKI_STATE_DATABASE_URL=postgresql://pv_wiki_app:password@postgres:5432/pv_wiki_state
# Optional hints/overrides for the bundled manufacturer registry.
PV_WIKI_PUBLIC_BRAND_ALIASES_JSON=
PV_WIKI_TRUSTED_SOURCE_DOMAINS_JSON=
PV_WIKI_HTTP_TIMEOUT=30

# Legacy /run-one rollback configuration only; unused by /datasheet/*.
# Keep provider credentials out of the new Python tool service.
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
